{
  "name": "react-kavia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.4",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.2",
    "react-scripts": "^5.0.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "http-proxy-middleware": "^2.0.6"
  },
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=256 GENERATE_SOURCEMAP=${REACT_APP_ENABLE_SOURCE_MAPS:-false} BROWSER=none react-scripts start",
    "start:smaps": "cross-env NODE_OPTIONS=--max-old-space-size=512 GENERATE_SOURCEMAP=true BROWSER=none react-scripts start",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=256 GENERATE_SOURCEMAP=${REACT_APP_ENABLE_SOURCE_MAPS:-false} BROWSER=none react-scripts start",
    "build": "cross-env GENERATE_SOURCEMAP=${REACT_APP_ENABLE_SOURCE_MAPS:-false} react-scripts build",
    "test": "cross-env CI=true react-scripts test --watchAll=false",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
