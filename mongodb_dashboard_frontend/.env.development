# Development environment configuration for CRA dev server stability in container/preview
# Bind to all interfaces so the preview system can reach the server
HOST=0.0.0.0
PORT=3000
BROWSER=none

# Webpack Dev Server socket settings: ensure client websocket connects correctly via preview
WDS_SOCKET_HOST=0.0.0.0
WDS_SOCKET_PORT=3000
WDS_SOCKET_PATH=/ws

# CRA-specific flags
# Disable host check to allow reverse proxies/preview hosts
DANGEROUSLY_DISABLE_HOST_CHECK=true

# API calls should use same-origin '/api' which is proxied to backend on :3001 by setupProxy.js
REACT_APP_API_PREFIX=/api
