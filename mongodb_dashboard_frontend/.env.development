# Development environment configuration for CRA dev server stability in container/preview.
#
# IMPORTANT:
# Many preview/reverse-proxy systems probe the dev server via localhost inside the container.
# Binding CRA to 0.0.0.0 can cause the preview health probe to fail and the orchestration
# layer to terminate the process (reported as "blocked/exited with code 1" even after a
# successful compile).
#
# Therefore we default to localhost binding and let the preview harness override HOST/PORT
# when it needs different behavior.
HOST=127.0.0.1
PORT=3000
BROWSER=none

# Webpack Dev Server socket settings: keep conservative defaults.
# If the preview system requires explicit socket host/port/path, it can override these.
WDS_SOCKET_HOST=127.0.0.1
WDS_SOCKET_PORT=3000
WDS_SOCKET_PATH=/ws

# CRA-specific flags
# Disable host check to allow reverse proxies/preview hosts
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Existing app config (prefer REACT_APP_API_BASE_URL if provided at runtime)
REACT_APP_API_PREFIX=/api
