# Frontend environment example

# Preferred: includes '/api' suffix
REACT_APP_API_BASE_URL=https://your-backend.example.com/api
# Alternative URL key supported as fallback
REACT_APP_API_URL=https://your-backend.example.com/api

# Development proxy config
REACT_APP_BACKEND_PORT=3001
# Timeout (ms) for CRA proxy to backend (applies to both timeout and proxyTimeout)
REACT_APP_PROXY_TIMEOUT_MS=180000

# Axios and fetch client timeouts (ms)
REACT_APP_AXIOS_TIMEOUT_MS=180000
REACT_APP_FETCH_TIMEOUT_MS=180000
