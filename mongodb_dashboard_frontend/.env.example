# Frontend environment variables (copy to .env and adjust)
# Preferred: use relative API paths in code (e.g., fetch('/api/...'))
# The CRA proxy (src/setupProxy.js) will forward to the backend dev server.
REACT_APP_BACKEND_PORT=3001
# Optionally set a full base URL if proxy is not used:
# REACT_APP_API_BASE_URL=http://localhost:3001
