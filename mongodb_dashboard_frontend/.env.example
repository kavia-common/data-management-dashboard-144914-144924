# PUBLIC_INTERFACE
# Example environment variables for the frontend app

# If backend is hosted on a different origin, set full base URL (may include /api suffix).
# When unset, the app uses same-origin '/api' which works with CRA dev proxy.
REACT_APP_API_BASE_URL=

# Alternative legacy name (still supported by proxy): if provided, it will be used as target.
REACT_APP_API_URL=

# Dev-only: Backend port used when resolving proxy target if REACT_APP_API_BASE_URL is not set.
REACT_APP_BACKEND_PORT=3001

# Dev-only: Backend host for proxy target. Prefer container name or 172.17.0.2 in preview,
# NOT 'localhost' when frontend runs in a separate container.
# Examples:
# REACT_APP_PROXY_HOST=mongodb_dashboard_backend
# REACT_APP_PROXY_HOST=172.17.0.2
REACT_APP_PROXY_HOST=
