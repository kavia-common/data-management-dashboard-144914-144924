# Example environment variables for mongodb_dashboard_frontend
# Do not commit real secrets. Copy to .env and adjust values as appropriate.

# Controls how many credits equal 1 USD in currency utils
REACT_APP_CREDITS_PER_USD=20000

# Optional: enable dev-only crypto demo that dynamically imports ./utils/crypto
# Default is disabled to avoid unnecessary dev chunk loads.
REACT_APP_ENABLE_CRYPTO_DEMO=false
